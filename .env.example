# Wayfarer environment configuration
# Copy to .env and fill in your keys. Unset keys disable the corresponding
# provider in the LLM router (it falls back to the next configured one).

# --- LLM Router providers ---
# Default to local Ollama (no API keys needed) — the only provider that works
# out of the box. NVIDIA/OpenRouter are optional; leave blank to disable.
# Options: ollama | nvidia | openrouter | lmstudio | custom
LLM_PROVIDER=ollama
# NVIDIA NIM free tier (optional — model IDs change often; regenerate from live catalog)
NVIDIA_NIM_API_KEY=
# OpenRouter free tier (optional)
OPENROUTER_API_KEY=

# --- Search APIs (Stage 1) ---
# Tavily is primary; Brave is the fallback
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- Job Board APIs (Stage 3) ---
# bluedoor.sh — free tier available at https://bluedoor.sh/apis/job-postings
BLUEDOOR_API_KEY=

# --- Docker Compose overrides (defaults are fine for local dev) ---
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333
# OLLAMA_ENDPOINT=http://ollama:11434
# REDIS_URL=redis://redis:6379
