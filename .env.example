# Wayfarer environment configuration
# Copy to .env and fill in your keys. Unset keys disable the corresponding
# provider in the LLM router (it falls back to the next configured one).

# --- LLM Router providers (need at least one) ---
# Set LLM_PROVIDER to choose the primary provider.
# Options: nvidia | openrouter | ollama
# When using Ollama locally, no API keys are needed.
LLM_PROVIDER=ollama
# NVIDIA NIM free tier
NVIDIA_NIM_API_KEY=
# OpenRouter free tier
OPENROUTER_API_KEY=

# --- Search APIs (Stage 1) ---
# Tavily is primary; Brave is the fallback
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- Job Board APIs (Stage 3) ---
# bluedoor.sh — free tier available at https://bluedoor.sh/apis/job-postings
BLUEDOOR_API_KEY=
# Adzuna — free tier for India job search (https://developer.adzuna.com/)
ADZUNA_API_KEY=
# Greenhouse — target-list boards (comma-separated company slugs)
# GREENHOUSE_BOARD_TOKENS=anthropic,openai,google
# Lever — target-list boards (comma-separated company slugs)
# LEVER_POSTING_URLS=anthropic,stripe,airbnb
# Workday — target-list boards (comma-separated company/site paths)
# WORKDAY_URLS=anthropic/jobs,google/jobs

# --- User Preferences (Stage 3) ---
# Set to true to flag postings with "no visa sponsorship" as hard blockers
NEEDS_VISA_SPONSORSHIP=false

# --- Docker Compose overrides (defaults are fine for local dev) ---
# CHROMA_HOST=chromadb
# CHROMA_PORT=8000
# OLLAMA_ENDPOINT=http://ollama:11434
# REDIS_URL=redis://redis:6379
